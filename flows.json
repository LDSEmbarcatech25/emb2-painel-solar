    {
        "id": "457c9f3bfb56774b",
        "type": "ui-template",
        "z": "377cf312cc9cba38",
        "group": "8405d469c48bf0a5",
        "page": "",
        "ui": "",
        "name": "",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n    <div class=\"container\">\n        <img\n            v-if=\"imagemAtual\"\n            :src=\"imagemAtual\"\n            class=\"imagem\"\n        />\n\n        <v-btn\n            @click=\"tirarFoto\"\n            class=\"botao\"\n        >\n            Tirar Foto\n        </v-btn>\n    </div>\n</template>\n\n<script>\nexport default {\n    data() {\n        return {\n            imagemAtual: null,\n            alternador: false,\n            painelLimpo: \"https://raw.githubusercontent.com/AlvesAlbano/teste-imagens-scrapper/main/painel_limpo.png\",\n            painelSujo: \"https://raw.githubusercontent.com/AlvesAlbano/teste-imagens-scrapper/main/painel_sujo.png\"\n        }\n    },\n\n    methods: {\n        tirarFoto() {\n            this.alternador = !this.alternador\n\n            this.imagemAtual = this.alternador\n                ? this.painelSujo\n                : this.painelLimpo\n        }\n    }\n}\n</script>\n\n<style>\n.container {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n}\n\n.imagem {\n    width: 100%;\n    height: auto;\n    border-radius: 8px;\n    margin-bottom: 15px;\n}\n\n.botao {\n    align-self: center;\n}\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 620,
        "y": 100,
        "wires": [
            []
        ]
    },
    {
        "id": "4563f62c68a7f581",
        "type": "ui-template",
        "z": "377cf312cc9cba38",
        "group": "874e63a46c469f32",
        "page": "",
        "ui": "",
        "name": "form",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n    <div>\n        <!-- <h2>Ligar Válvula</h2> -->\n\n        <!-- Campo obrigatório -->\n        <v-text-field v-model=\"tempo\" label=\"Tempo segundos\" type=\"number\" min=\"4\" max=\"60\" required :error=\"erro\"\n            :error-messages=\"mensagemErro\"></v-text-field>\n\n        <!-- Botões -->\n        <div style=\"display:flex; gap:10px;\">\n            <v-btn color=\"primary\" @click=\"enviar\">\n                Enviar\n            </v-btn>\n\n            <v-btn color=\"error\" variant=\"outlined\" @click=\"limpar\">\n                Limpar\n            </v-btn>\n        </div>\n\n    </div>\n</template>\n\n<script>\n    export default {\n    data() {\n        return {\n            tempo: '',\n            tempoEnviado: null,\n            erro: false,\n            mensagemErro: ''\n        }\n    },\n\n    methods: {\n        enviar() {\n            const valor = Number(this.tempo)\n\n            // validação\n            if (!this.tempo) {\n                this.erro = true\n                this.mensagemErro = 'Campo obrigatório'\n                return\n            }\n\n            if (valor < 4 || valor > 60) {\n                this.erro = true\n                this.mensagemErro = 'O valor deve estar entre 4 e 60 segundos'\n                return\n            }\n\n            this.erro = false\n            this.mensagemErro = ''\n            this.tempoEnviado = valor\n\n            // envia mensagem para o Node-RED\n            this.send({\n                payload: {\n                    \"cmd\":\"ligar\",\n                    \"tempo_segundos\": valor\n                }\n            })\n        },\n\n        limpar() {\n            // limpa os campos\n            this.tempo = ''\n            this.tempoEnviado = null\n            this.erro = false\n            this.mensagemErro = ''\n\n            // opcional: envia evento de limpeza\n            // this.send({\n            //     payload: {\n            //         acao: 'limpar'\n            //     }\n            // })\n        }\n    }\n}\n</script>\n\n<style>\n    h2 {\n        margin-bottom: 15px;\n    }\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 90,
        "y": 780,
        "wires": [
            [
                "c79b4a7b93ea8faa",
                "29f2c66f91cd7385",
                "1bfeaf09c7328a51"
            ]
        ]
